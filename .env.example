# Chat/reasoning LLM -- any OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
MAST_CHAT_MODEL=gpt-4o-mini
MAST_TEMPERATURE=0.0
# Fail a single stuck/dropped call fast and retry, rather than hanging on the
# client's default ~10min timeout for the whole batch run.
MAST_REQUEST_TIMEOUT=120
MAST_REQUEST_MAX_RETRIES=2

# LLM judge (mast_indic/eval.py) -- defaults to the chat LLM settings above
# if left unset; set these to use a separate/cheaper judge model instead.
# MAST_JUDGE_BASE_URL=http://localhost:8000/v1
# MAST_JUDGE_API_KEY=not-needed
# MAST_JUDGE_MODEL=Qwen/Qwen3-32B

# Interact-RAG-style agent (mast_indic/interact_agent.py) -- one model per
# role (Global-Planner / Adaptive-Reasoner / Executor), each defaulting to
# MAST_CHAT_MODEL if unset. All share OPENAI_BASE_URL/OPENAI_API_KEY.
# MAST_PLANNER_MODEL=gpt-4o-mini
# MAST_REASONER_MODEL=gpt-4o-mini
# MAST_EXECUTOR_MODEL=gpt-4o-mini

# Embeddings (retrieval only, not chat) -- any OpenAI-compatible /v1/embeddings
# server: defaults to local Ollama, but point MAST_EMBED_BASE_URL at a vLLM/TEI
# server to use those instead.
MAST_EMBED_BASE_URL=http://localhost:11434/v1
MAST_EMBED_API_KEY=not-needed
MAST_EMBED_MODEL=embeddinggemma:300m

# Corpus / index
MAST_CORPUS_DATASET=Tevatron/browsecomp-plus-corpus
MAST_QUERIES_DATASET=mast-benchmark/indic-queries-2026
MAST_INDEX_DIR=index_store
MAST_CHUNK_WORDS=220
MAST_CHUNK_OVERLAP_WORDS=40

# Agent loop
MAST_MAX_TURNS=8
MAST_TOP_K=5
MAST_SNIPPET_MAX_TOKENS=400

# Output
MAST_RUNS_DIR=runs

# Debugging: print each turn's reasoning/tool-calls/answer to stderr (or pass --debug)
MAST_DEBUG=false
